# Engosoft Zoom Bot — Environment Variables
# Copy this to .env and fill in values

# Zoom SDK Credentials (General App → App Credentials)
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# Zoom Server-to-Server OAuth
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Bot Config
BOT_NAME=Engosoft Bot
PORT=3000

# Security key — n8n بيبعته في كل request كـ x-bot-key header
SECRET_KEY=
